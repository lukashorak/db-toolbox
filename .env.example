# Copy to .env for local development. Never commit .env.
NODE_ENV=development
# Origin of the workbench as users reach it (no path). HTTPS is required in production.
# In development that is the Vite server (npm run dev:web), which proxies the API, so the sign-in
# callback lands on the live GUI; use http://127.0.0.1:3000 when the API serves the built app.
PUBLIC_URL=http://127.0.0.1:5173
# Issuer URL of the Keycloak realm, for example https://auth.example.com/realms/workbench
KEYCLOAK_ISSUER=https://auth.example.test/realms/workbench
# 32 random bytes, base64. Generate once and keep it outside backups of the data folder:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
EXPORT_DIR=./exports
LOG_LEVEL=info
# On SIGTERM, how long running executions may finish before they are interrupted.
SHUTDOWN_GRACE_MS=20000
# Requests per minute per user, per user and MCP client, and rejected tokens per address (0 = off).
# RATE_LIMIT_PER_MINUTE=600
# MCP_RATE_LIMIT_PER_MINUTE=300
# AUTH_FAILURES_PER_MINUTE=60
