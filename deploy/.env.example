# Copy to .env next to compose.yaml. Never commit .env.
# Keep a copy of ENCRYPTION_KEY outside the backups of ./data: a backup is useless without it,
# and the key must not travel with the backup.

# Image built on this host (docker build -t database-workbench:0.1.0 .) or pulled from a registry.
WORKBENCH_IMAGE=database-workbench:latest
# Where the container is published for the reverse proxy (loopback by default).
WORKBENCH_BIND=127.0.0.1
WORKBENCH_PORT=3000

# Origin users reach, HTTPS, no path. The GUI, OAuth callbacks and MCP discovery all use it.
PUBLIC_URL=https://db.example.com
# Issuer URL of the Keycloak realm.
KEYCLOAK_ISSUER=https://auth.example.com/realms/workbench
# 32 random bytes, base64:
#   docker run --rm node:24.22.2-bookworm-slim node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# The reverse proxy sets X-Forwarded-For and X-Forwarded-Proto.
TRUST_PROXY=true
LOG_LEVEL=info

# Optional limits (defaults shown).
# PREVIEW_ROWS=1000
# MCP_PREVIEW_ROWS=1000
# MCP_PREVIEW_BYTES=262144
# MAX_RESULT_BYTES=104857600
# MAX_TOTAL_BYTES=1073741824
# CONCURRENCY_PER_CONNECTION=2
# ORDINARY_TIMEOUT_MS=30000
# FULL_TIMEOUT_MAX_MS=300000
# SHUTDOWN_GRACE_MS=20000
