# .env for the Dockge stack on the Hetzner server (next to compose.yaml). Never commit the filled-in file.
# Keep a copy of ENCRYPTION_KEY in the password manager, apart from the backups of ./data.

WORKBENCH_IMAGE=registry.sensay-learning.com/db-tool:0.1.0
WORKBENCH_BIND=127.0.0.1
WORKBENCH_PORT=3000

PUBLIC_URL=https://db-tool.sensay-learning.com
KEYCLOAK_ISSUER=https://kc.sensay-learning.com/realms/db-tool
# Generate once on the server:
#   docker run --rm registry.sensay-learning.com/db-tool:0.1.0 node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# nginx on the same host sets X-Forwarded-For and X-Forwarded-Proto.
TRUST_PROXY=true
LOG_LEVEL=info
