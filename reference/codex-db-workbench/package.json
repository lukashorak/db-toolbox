{
  "name": "db-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --import tsx --watch src/api/main.ts",
    "dev:web": "vite --config web/vite.config.ts --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "check": "tsc -p tsconfig.json --noEmit && svelte-check --tsconfig ./web/tsconfig.json",
    "start": "node dist/api/main.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:browser": "node --import tsx tests/browser-smoke.ts",
    "format": "prettier --write src tests web scripts docs README.md package.json tsconfig.json compose.yaml"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "jose": "6.2.15",
    "mysql2": "3.24.6",
    "node-sql-parser": "5.4.0",
    "oidc-client-ts": "3.5.0",
    "pg": "8.23.1",
    "pg-cursor": "2.22.1",
    "svelte": "5.57.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-socket": "0.2.18",
    "@sparticuz/chromium": "153.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/pg-cursor": "2.7.2",
    "embedded-postgres": "18.6.0-beta.19",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.6"
  }
}
