PUBLIC_URL=https://db.example.com
KEYCLOAK_ISSUER=https://auth.example.com/realms/db-workbench
GUI_CLIENT_ID=workbench-gui
API_AUDIENCE=workbench-api
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this key separate from database backups. Losing it loses stored credentials.
ENCRYPTION_KEY=
BIND_ADDRESS=127.0.0.1
HOST_PORT=3000
MAX_RESULT_BYTES=104857600
MAX_TOTAL_BYTES=1073741824
